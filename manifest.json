{
  "action": {
    "default_title": "Flow Automation - Auto Flow on Google Flow"
  },
  "author": {
    "email": "kylenguyenaws@gmail.com"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "all_frames": false,
      "js": [
        "assets/index.ts-loader-CBrD-M0v.js"
      ],
      "matches": [
        "*://flow.google.com/*"
      ],
      "run_at": "document_end"
    }
  ],
  "description": "Auto Flow your prompts at scale. Batch generate and auto-download videos and images on Google Flow.",
  "host_permissions": [
    "*://flow.google.com/*",
    "http://127.0.0.1:8765/*",
    "ws://127.0.0.1:8765/*"
  ],
  "icons": {
    "16": "src/assets/logo.png",
    "24": "src/assets/logo.png",
    "32": "src/assets/logo.png",
    "128": "src/assets/logo.png"
  },
  "manifest_version": 3,
  "name": "VEO Automation (Unlocked)",
  "offline_enabled": true,
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "activeTab",
    "downloads",
    "debugger",
    "scripting",
    "alarms"
  ],
  "side_panel": {
    "default_path": "src/ui/side-panel/index.html"
  },
  "version": "3.4.4.0",
  "version_name": "3.4.4",
  "web_accessible_resources": [
    {
      "matches": [
        "*://flow.google.com/*"
      ],
      "resources": [
        "assets/utils-BCNko0UU.js",
        "assets/catchUploadFile.ts-DJwIizxX.js",
        "assets/index.ts-DFAayvhs.js",
        "src/ui/side-panel/spec-pipeline.js",
        "src/ui/side-panel/spec-pipeline.css",
        "character_creation_sample.json",
        "sample_spec.json"
      ],
      "use_dynamic_url": false
    }
  ]
}